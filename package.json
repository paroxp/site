{
  "name": "paroxp.com",
  "version": "4.0.0",
  "description": "Rafal Proszowski - Resume",
  "main": "src/generator.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paroxp/site.git"
  },
  "author": "Rafal Proszowski",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/paroxp/site/issues"
  },
  "homepage": "https://github.com/paroxp/site#readme",
  "scripts": {
    "build:clean": "rm -rf dist/",
    "build:prepare": "mkdir dist/",
    "build:static": "ts-node src/generator.ts",
    "build": "npm run -s build:clean && npm run -s build:prepare && npm run -s build:static",
    "fix:ts": "eslint --fix .",
    "fix:vulnerabilities": "npm audit fix --update-binary",
    "fix": "npm run -s fix:ts",
    "lint:ts": "eslint .",
    "lint": "npm run -s lint:ts",
    "start": "ts-node src/serve.ts",
    "test:audit": "npm audit",
    "test:types": "tsc --noEmit",
    "test": "npm run -s lint && npm run -s test:types"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.12.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "html-minifier-terser": "^7.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.100.0",
    "sitemap": "^9.0.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
