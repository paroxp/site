{
  "compilerOptions": {
    "strict": true,
    "outDir": "dist",
    "module": "commonjs",
    "target": "es6",
    "jsx" :  "react",
    "lib": [
      "es2015",
      "es2016.array.include",
      "es2017",
      "dom"
    ],
    "sourceMap": false,
    "resolveJsonModule": true,
    "inlineSources": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "rootDir": ".",
    "noImplicitAny": true,
    "isolatedModules": false,
    "pretty": true,
    "allowJs": true,
    "importHelpers": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "ts-node": {
    "transpileOnly": true
  }
}
